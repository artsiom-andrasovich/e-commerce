{
  "compilerOptions": {
   "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "checkJs": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
  }
}
