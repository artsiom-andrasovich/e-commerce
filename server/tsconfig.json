

{
  "exclude": [
    "./coverage",
    "./dist",
    "**/*.test.ts",
    "jest.config.js",
    "eslint.config.mjs"
  ],
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "node",
    "checkJs": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "@utils":[
        "src/utils/"
      ],
      "@utils/*":[
        "src/utils/*"
      ],
      "@categories":[
        "src/categories/"
      ],
      "@categories/*":[
        "src/categories/*"
      ],
      "@middlewares":[
        "src/middlewares/"
      ],
      "@middlewares/*":[
        "src/categories/*"
      ],
    }
  }
}

